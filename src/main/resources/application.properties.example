postcode=DH1 4HU
debug=true

# Dashboard Configuration
dashboard.admin-tab-enabled=true

# SSE Configuration
sse.heartbeat-interval=10000

# Hue Bridge Configuration
hue.hub-address=YOUR_HUE_BRIDGE_IP
hue.hub-id=YOUR_HUE_BRIDGE_ID
hue.application-key=YOUR_HUE_APPLICATION_KEY
hue.start-scene=YOUR_START_SCENE_ID
hue.stop-scene=YOUR_STOP_SCENE_ID
hue.status-interval=10000
hue.scene-catalog-interval=300000

# IKEA DIRIGERA Hub Configuration
dirigera.hub-address=YOUR_DIRIGERA_HUB_IP
dirigera.status-interval=10000

# PLEX Movie Command Configuration
plex.movie-play-enabled=true
plex.movie-resume-enabled=true
plex.movie-stop-enabled=true
plex.movie-pause-enabled=true
plex.movie-scrobble-enabled=false

# PLEX TV Show (episode) Command Configuration
plex.episode-play-enabled=false
plex.episode-resume-enabled=false
plex.episode-stop-enabled=false
plex.episode-pause-enabled=false
plex.episode-scrobble-enabled=false

# PLEX Clip Command Configuration
plex.clip-play-enabled=false
plex.clip-resume-enabled=false
plex.clip-stop-enabled=false
plex.clip-pause-enabled=false
plex.clip-scrobble-enabled=false

# Security Configuration
app.admin.username=admin
app.admin.password=${CINELIGHT_ADMIN_PASSWORD}
